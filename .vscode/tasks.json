{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup (venv + dependencies)",
      "type": "shell",
      "command": "npm run setup",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: run",
      "type": "shell",
      "command": "npm run dev:backend",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": { "activeOnStart": true, "beginsPattern": ".", "endsPattern": "Uvicorn running on" }
      },
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "App: Tauri dev",
      "type": "shell",
      "command": "npm run tauri:dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "Browser: ng serve",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "Dev: backend + Tauri app",
      "dependsOn": ["Backend: run", "App: Tauri dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Build installer (this OS)",
      "type": "shell",
      "command": "npm run app:build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Download models + ffmpeg",
      "type": "shell",
      "command": "npm run assets:fetch",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    }
  ]
}
