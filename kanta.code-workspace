{
	"folders": [
		{
			"name": "Frontend (Angular)",
			"path": "frontend"
		},
		{
			"name": "Backend (FastAPI)",
			"path": "backend"
		},
		{
			"name": "Docs",
			"path": "docs"
		}
	],
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Dev: backend + Tauri app",
				"type": "shell",
				"command": "npm run dev:all",
				"options": {
					"cwd": "${workspaceFolder:Frontend (Angular)}"
				},
				"isBackground": true,
				"problemMatcher": [],
				"presentation": {
					"reveal": "always",
					"panel": "dedicated"
				}
			},
			{
				"label": "Build installer (this OS)",
				"type": "shell",
				"command": "npm run app:build",
				"options": {
					"cwd": "${workspaceFolder:Frontend (Angular)}"
				},
				"group": "build",
				"problemMatcher": []
			}
		]
	},
	"settings": {
		"files.exclude": {
			"**/.angular": true,
			"**/__pycache__": true,
			"**/.pytest_cache": true
		},
		"files.watcherExclude": {
			"**/.angular/**": true,
			"**/venv/**": true,
			"**/node_modules/**": true
		},
		"chat.tools.terminal.autoApprove": {
			"printf": true
		}
	}
}
