{
	"folders": [
		{
			"name": "Frontend (Angular)",
			"path": "frontend"
		},
		{
			"name": "Backend (FastAPI)",
			"path": "backend"
		},
		{
			"name": "Docs",
			"path": "docs"
		}
	],
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Start Frontend",
				"type": "shell",
				"command": "npm run dev",
				"options": {
					"cwd": "${workspaceFolder:Frontend (Angular)}"
				},
				"isBackground": true,
				"problemMatcher": {
					"owner": "custom",
					"pattern": {
						"regexp": "^$"
					},
					"background": {
						"activeOnStart": true,
						"beginsPattern": ".",
						"endsPattern": "localhost:4200"
					}
				},
				"presentation": {
					"group": "dev-servers",
					"reveal": "always",
					"panel": "dedicated"
				}
			},
			{
				"label": "Start Backend",
				"type": "shell",
				"command": "source venv/bin/activate && uvicorn app.main:app --reload --port 8000",
				"options": {
					"cwd": "${workspaceFolder:Backend (FastAPI)}",
					"shell": {
						"executable": "/bin/bash",
						"args": [
							"-c"
						]
					}
				},
				"isBackground": true,
				"problemMatcher": {
					"owner": "custom",
					"pattern": {
						"regexp": "^$"
					},
					"background": {
						"activeOnStart": true,
						"beginsPattern": ".",
						"endsPattern": "Uvicorn running on"
					}
				},
				"presentation": {
					"group": "dev-servers",
					"reveal": "always",
					"panel": "dedicated"
				}
			},
			{
				"label": "Start Dev Servers",
				"dependsOrder": "parallel",
				"dependsOn": [
					"Start Frontend",
					"Start Backend"
				],
				"runOptions": {
					"runOn": "folderOpen"
				},
				"problemMatcher": []
			}
		]
	},
	"settings": {
		"files.exclude": {
			"**/.angular": true,
			"**/__pycache__": true,
			"**/.pytest_cache": true
		},
		"files.watcherExclude": {
			"**/.angular/**": true,
			"**/venv/**": true,
			"**/node_modules/**": true
		},
		"chat.tools.terminal.autoApprove": {
			"printf": true
		}
	}
}
